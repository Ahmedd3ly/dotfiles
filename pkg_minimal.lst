# =====================================================================
# pkg_minimal.lst: every package installed on purpose, one line each with why.
# Single source of truth for a rebuild (the old pkglist-*.txt dumps are gone).
# Install (paru handles repo + AUR):
#   awk '!/^[[:space:]]*#/ && NF {print $1}' ~/.local/share/chezmoi/pkg_minimal.lst | paru -S --needed -
# Already installed by pacstrap during the Arch install, so NOT repeated here:
#   base base-devel linux linux-firmware intel-ucode sudo btrfs-progs grub
#   grub-btrfs inotify-tools efibootmgr networkmanager zram-generator
#   pacman-contrib zsh neovim git cronie reflector
# AUR (6, each justified inline): paru-bin, bibata-cursor-theme-bin,
#   wkhtmltopdf-bin, vesktop-bin, spicetify-cli, heroic-games-launcher-bin.
# Audit: compare with `pacman -Qqe` (see RUNBOOK.md, "Package audit").
# =====================================================================

# --------------------------------------------------- // Base
timeshift                   # snapshots
tlp                         # laptop power (then: sudo systemctl enable --now tlp; mask systemd-rfkill.service/.socket)
tlp-pd                      # TLP profiles over the power-profiles-daemon D-Bus API (bar switcher; sudo systemctl enable --now tlp-pd)
sof-firmware                # Intel audio DSP firmware: no speakers/mic on this laptop without it
chezmoi                     # this repo
pacutils                    # pacreport: unowned files and package audit (RUNBOOK.md, "Package audit")
etckeeper                   # /etc under git (local only)
man-db
man-pages
paru-bin                    # (AUR) AUR helper; -bin = prebuilt, no Rust toolchain to build it

# --------------------------------------------------- // GPU (hybrid Intel + NVIDIA)
mesa
vulkan-icd-loader
vulkan-intel
intel-media-driver          # VA-API (iHD) decode on the iGPU
nvidia-open                 # RTX 40-series is supported by the open modules
nvidia-utils                # also gives you nvidia-smi
nvidia-prime                # prime-run for offloading
egl-wayland
# libva-nvidia-driver       # only if you want NVIDIA video decode; Intel (iHD) is the default

# --------------------------------------------------- // Session
uwsm                        # Wayland session manager (start from tty, no display manager)
hyprland
xorg-xwayland               # X11 apps, Steam and Proton need it
lua                         # Hyprland's Lua config
hyprpolkitagent             # auth agent
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk      # file picker
xdg-user-dirs
xdg-terminal-exec           # GLib/Thunar/uwsm launch terminal apps
hypridle                    # idle daemon
hyprlock                    # lock screen
hyprsunset                  # night light

# --------------------------------------------------- // Shell UI (the rice core)
waybar                      # bar
rofi                        # launcher + power menu + clipboard picker
python-pillow               # wall-cache: wallpaper crops for rofi (instead of ImageMagick)
mako                        # notifications: Wayland-native, one small config file to template
awww                        # wallpaper daemon with transitions (formerly swww)
libnotify                   # notify-send

# --------------------------------------------------- // Audio / network / bluetooth
pipewire
pipewire-alsa
pipewire-pulse
wireplumber                 # also gives you wpctl, replaces pamixer
pavucontrol                 # one GUI mixer
noise-suppression-for-voice # RNNoise LADSPA plugin for the PipeWire mic filter (pipewire.conf.d/60-rnnoise.conf)
playerctl
cava                        # terminal audio visualiser, coloured from the wallpaper (matugen)
bluez
bluetui                     # TUI bluetooth manager (talks to bluez directly; no bluez-utils needed)
brightnessctl

# --------------------------------------------------- // Clipboard & capture
wl-clipboard                # missing from HyDE's lists, essential
cliphist
wl-clip-persist
grim
slurp
wf-recorder                 # screen recording (CLI, Wayland screencopy like grim; region via slurp; VA-API h264 on the iGPU)
satty                       # screenshot annotation
hyprpicker                  # color picker
jq                          # glue for scripts

# --------------------------------------------------- // Theming engine (replaces wallbash)
matugen                     # extra repo; wallpaper -> accent colours via templates (v4: source_color_index in config)
adw-gtk-theme               # GTK3/4 base that recolors cleanly
bibata-cursor-theme-bin     # (AUR)
tela-circle-icon-theme-dracula # icon theme for rofi + GTK, as on HyDE (official repo)
dconf                       # gsettings backend
qt6ct                       # Qt platform theme (QT_QPA_PLATFORMTHEME in uwsm env) for the Qt bits below
qt6-wayland                 # screen-share picker (xdg-desktop-portal-hyprland, Qt) native on Wayland; polkit dialog itself is hyprtoolkit

# --------------------------------------------------- // Fonts
ttf-jetbrains-mono-nerd
ttf-cascadia-code-nerd      # kitty font (CaskaydiaCove, as on HyDE)
noto-fonts                  # includes Arabic coverage
noto-fonts-emoji
wqy-microhei                # 5 MB CJK fallback (e.g. U+3022 〢 in Discord names); noto-fonts-cjk is 300 MB

# --------------------------------------------------- // Apps
firefox                     # official repo, native Wayland
kitty
thunar                      # replaces dolphin + the KDE dependency chain
thunar-archive-plugin
thunar-volman
gvfs                        # trash, automount (replaces udiskie)
tumbler                     # thumbnails
ffmpegthumbnailer
file-roller                 # engine behind Thunar's Extract here / Create archive (thunar-archive-plugin)
unzip                       # Mason needs it to unpack language servers
fastfetch                   # runs on every new shell
mpv                         # video player
spotify-launcher            # official Spotify client, per-user install in ~/.local/share (self-updates; Spicetify can write to it)
spicetify-cli               # (AUR) Spotify theming (static Catppuccin Mocha); nothing official can theme Spotify
vesktop-bin                 # (AUR) Discord with Vencord built in and working Wayland screenshare; -bin = no Electron build

# --------------------------------------------------- // Shell (zsh is installed already)
zsh-autosuggestions         # fish-style suggestions, no framework needed
zsh-syntax-highlighting
zsh-completions
starship
fzf
eza

# --------------------------------------------------- // Development (Neovim / LazyVim, Python)
ripgrep                     # LazyVim grep / picker
fd                          # LazyVim file finder
lazygit                     # git UI inside Neovim
tree-sitter-cli             # LazyVim builds parsers with it
nodejs                      # Mason: several language servers run on Node
npm
uv                          # Python tools and venvs

# --------------------------------------------------- // Work: Odoo
postgresql                  # Odoo database
openldap                    # headers/libs for Odoo's python-ldap
wkhtmltopdf-bin             # (AUR) Odoo PDF reports need the patched-Qt build; not in the official repos

# =====================================================================
# LATER: uncomment when needed
# =====================================================================

# --------------------------------------------------- // Gaming (needs [multilib] enabled in pacman.conf)
# Launcher: SUPER+Shift+G (~/.local/bin/gamelauncher) lists Steam, Heroic and /games.
steam                       # Steam client; Proton for Windows games; library on /games/SteamLibrary
lib32-mesa                  # 32-bit Intel GL/Vulkan for Steam and older games
lib32-vulkan-intel          # 32-bit Vulkan on the iGPU (pulls lib32-vulkan-icd-loader)
lib32-nvidia-utils          # 32-bit NVIDIA driver; must match nvidia-utils' version
heroic-games-launcher-bin   # (AUR) Epic, GOG, Amazon; upstream's one supported Arch package
# Not installed, on purpose (add when a real need shows up):
#   gamemode   Feral daemon: CPU governor/priority tweaks while a game runs; overlaps TLP
#              here, small gains on a 24-core HX CPU, plugged in when gaming anyway
#   mangohud   FPS/frametime overlay: for benchmarking, which this machine doesn't do
#   gamescope  nested compositor for upscaling/frame limits/HDR; flaky on NVIDIA under
#              Hyprland, and HDR is off on the G5. Fix per game if one misbehaves
