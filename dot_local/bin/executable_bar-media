#!/usr/bin/env bash
# █▀▄▀█ █▀▀ █▀▄ █ ▄▀█
# █░▀░█ ██▄ █▄▀ █ █▀█
#
# Why: the centre media island from one source (playerctl), replacing
# waybar's mpris module, which stayed blank here. "<icon> title - artist"
# while playing or paused, "nothing playing" otherwise.
# Long titles scroll (marquee) while playing; paused or short titles sit
# still. Player changes arrive through playerctl --follow (no polling);
# the only timer is the scroll tick, and it runs only while a long title is
# playing. Every tick repaints the bar, so STEP_S is the battery knob.
set -uo pipefail
export LC_CTYPE=C.UTF-8   # count and cut characters, not bytes (Arabic titles)

WIDTH=40          # visible characters
STEP_S=0.4        # seconds per one-character scroll step
GAP="   •   "     # separator between repeats

fmt='{{status}}'$'\t''{{title}}'$'\t''{{artist}}'
status="" title="" artist="" full="" offset=0 last=""

print() {   # $1 text, $2 class
    local out
    out=$(jq -cn --arg t "$1" --arg ti "$title" --arg ar "$artist" --arg c "$2" \
        '{text: $t, class: $c,
          tooltip: (if $ti == "" then "No media player"
                    else $ti + (if $ar == "" then "" else "\n" + $ar end) end)}')
    [ "$out" = "$last" ] && return     # unchanged: no repaint
    last=$out
    echo "$out"
}

render() {
    local icon
    case "$status" in
        Playing) icon="󰐊" ;;
        Paused)  icon="󰏤" ;;
        *) print "󰎆  nothing playing" idle; return ;;
    esac
    if [ "${#full}" -le "$WIDTH" ]; then
        print "$icon  $full" "${status,,}"
    elif [ "$status" = Paused ]; then
        print "$icon  ${full:0:WIDTH-1}…" paused
    else
        local loop="$full$GAP"
        local twice="$loop$loop"
        print "$icon  ${twice:offset:WIDTH}" playing
        offset=$(( (offset + 1) % ${#loop} ))
    fi
}

update() {  # one "status<TAB>title<TAB>artist" line
    IFS=$'\t' read -r status title artist <<< "$1"
    status=${status:-} title=${title:-} artist=${artist:-}
    full="$title${artist:+ - $artist}"
    offset=0
}

update "$(playerctl metadata --format "$fmt" 2>/dev/null)"
render

exec 3< <(playerctl --follow metadata --format "$fmt" 2>/dev/null)

while :; do
    scrolling=0
    [ "$status" = Playing ] && [ "${#full}" -gt "$WIDTH" ] && scrolling=1

    if [ "$scrolling" = 1 ]; then
        IFS= read -r -t "$STEP_S" line <&3; rc=$?
    else
        IFS= read -r line <&3; rc=$?
    fi

    if [ "$rc" -eq 0 ]; then
        update "$line"
    elif [ "$rc" -le 128 ]; then
        exit 0          # playerctl ended: waybar's restart-interval restarts us
    fi                  # rc > 128: tick timeout, just advance the scroll
    render
done
