#!/usr/bin/env bash
# █░█ █▀█ █▀▄ ▄▀█ ▀█▀ █▀▀
# █▄█ █▀▀ █▄▀ █▀█ ░█░ ██▄
#
# Why: the panel behind the bar's updates icon (HyDE's system.update, rebuilt
# small). Summary per source (official repos, AUR): count, yellow "pending"
# or green "up to date". Then the pending packages, old -> new version, and
# "Apply updates now?". Yes = the same as `sysup`: a Timeshift snapshot,
# then paru -Syu (repos and AUR together). Afterwards it re-checks, shows the
# summary again and refreshes the bar's count.
# Usage: sysupdate   (the bar opens it in a floating kitty, class sysupdate)
set -uo pipefail

G=$'\e[1;32m' Y=$'\e[1;33m' R=$'\e[1;31m' B=$'\e[1m' D=$'\e[2m' N=$'\e[0m'
rule() { printf '%s%s%s\n' "$D" "────────────────────────────────────────────────────" "$N"; }

collect() {
    printf '%sChecking for updates…%s\r' "$D" "$N"
    # checkupdates: exit 0 = updates, 2 = none, 1 = could not check (network).
    repo_list=$(checkupdates 2>/dev/null); repo_rc=$?
    # paru -Qua exits 1 both when there's nothing and on failure: empty = 0.
    aur_list=$(paru -Qua 2>/dev/null)
    repo=$(grep -c . <<<"$repo_list"); aur=$(grep -c . <<<"$aur_list")
    total=$(( repo + aur ))
    printf '\e[2K'
}

row() {    # name count failed
    local state="${G}up to date${N}"
    if (( $3 )); then state="${R}couldn't check${N}"
    elif (( $2 )); then state="${Y}pending${N}"; fi
    printf '  %-22s %7s   %s\n' "$1" "$2" "$state"
}

summary() {
    printf '\n  %sSystem update%s\n' "$B" "$N"; rule
    printf '  %s%-22s %7s   %s%s\n' "$D" "Source" "Pending" "State" "$N"
    row "Official repositories" "$repo" "$(( repo_rc == 1 ))"
    row "AUR" "$aur" 0
    rule
    row "Total" "$total" 0
}

list() {   # title, "name old -> new" lines
    [[ -z $2 ]] && return
    printf '\n  %s%s%s\n' "$B" "$1" "$N"
    awk -v d="$D" -v g="$G" -v n="$N" \
        '{ printf "    %-28s %s%-20s%s →  %s%s%s\n", $1, d, $2, n, g, $4, n }' <<<"$2"
}

refresh_bar() {
    rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/waybar/updates.json"
    pkill -RTMIN+20 waybar 2>/dev/null
}

collect
summary
if (( total == 0 )); then
    printf '\n  %sSystem is up to date.%s\n' "$G" "$N"
else
    list "Official repositories" "$repo_list"
    list "AUR" "$aur_list"
    if grep -qE '^(linux|linux-firmware|nvidia[^ ]*|systemd|mesa) ' <<<"$repo_list"; then
        printf '\n  %sIncludes the kernel, drivers or systemd: reboot afterwards.%s\n' "$Y" "$N"
    fi
    read -rp $'\n  Apply updates now? [Y/n] ' answer
    if [[ -z $answer || $answer =~ ^[Yy] ]]; then
        printf '\n  %sSnapshot first (Timeshift), then paru -Syu%s\n\n' "$B" "$N"
        if sudo timeshift --create --comments "pre-upgrade $(date +%F)" && paru -Syu; then
            collect
            summary
        else
            printf '\n  %sUpgrade stopped or failed; nothing else was changed.%s\n' "$R" "$N"
        fi
    else
        printf '\n  %sSkipped.%s\n' "$Y" "$N"
    fi
fi
refresh_bar
read -rp $'\n  Enter to close ' _
