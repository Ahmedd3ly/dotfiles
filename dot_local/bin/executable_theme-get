#!/usr/bin/env bash
# ▀█▀ █░█ █▀▀ █▀▄▀█ █▀▀ ▄▄ █▀▀ █▀▀ ▀█▀
# ░█░ █▀█ ██▄ █░▀░█ ██▄ ░░ █▄█ ██▄ ░█░
#
# Why: the one place that knows which theme is active and where its files
# are, so wall-set, wall-pick, theme-pick and tutor never repeat the lookup.
# State: $XDG_STATE_HOME/theme/current holds the theme id (theme-set writes
# it); missing or unknown -> catppuccin-mocha, the setup this grew from.
# Usage:
#   theme-get              theme id            (catppuccin-mocha)
#   theme-get --palette    palette.json path   (~/.config/themes/<id>/palette.json)
#   theme-get --walls      wallpaper folder    (~/Pictures/Wallpapers/<id>)
#   theme-get <key>        a palette value     (mode, name, base, ... hex without #)
set -euo pipefail

themes="${XDG_CONFIG_HOME:-$HOME/.config}/themes"
state="${XDG_STATE_HOME:-$HOME/.local/state}/theme/current"
default=catppuccin-mocha

id=$(cat "$state" 2>/dev/null || true)
[ -n "$id" ] && [ -f "$themes/$id/palette.json" ] || id=$default
palette="$themes/$id/palette.json"

case "${1:-}" in
    "")        echo "$id" ;;
    --palette) echo "$palette" ;;
    --walls)   echo "${WALL_DIR:-$HOME/Pictures/Wallpapers}/$id" ;;
    *)         jq -er --arg k "$1" '.theme[$k]' "$palette" ;;
esac
