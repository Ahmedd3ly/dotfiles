#!/usr/bin/env bash
# █▀▄▀█ █▀▀ █▀▄ █ ▄▀█
# █░▀░█ ██▄ █▄▀ █ █▀█
#
# Why: waybar's mpris module hides when no player exists, which would leave
# the centre island empty. This prints a placeholder exactly then, and
# nothing while something is playing. Event-driven (playerctl --follow
# blocks), no polling. playerctl prints an empty line when the last player
# goes away.
set -uo pipefail

idle='{"text": "󰎆  nothing playing", "class": "idle"}'
busy='{"text": ""}'

show() {
    case "$1" in
        Playing|Paused) echo "$busy" ;;
        *)              echo "$idle" ;;
    esac
}

show "$(playerctl status 2>/dev/null)"
playerctl --follow status 2>/dev/null | while read -r status; do
    show "$status"
done
