#!/usr/bin/env bash
# █░█ █▀█ █▀▄ ▄▀█ ▀█▀ █▀▀ █▀
# █▄█ █▀▀ █▄▀ █▀█ ░█░ ██▄ ▄█
#
# Why: the ONLY caller of checkupdates / paru -Qua. Two checkupdates at once
# fight over their private DB and the loser fails, so every consumer goes
# through here: one lock, one check at a time. Writes ~/.cache/waybar/:
# repo.txt, aur.txt, repo.rc (checkupdates exit: 0 updates, 2 none, 1 failed)
# and updates.json for the bar. The sysupdate panel reads the lists.
# A good result younger than 2 minutes is reused; --force skips that (after
# an upgrade). One bar per monitor: they wait on the lock and reuse.
set -uo pipefail

cache="${XDG_CACHE_HOME:-$HOME/.cache}/waybar"
out="$cache/updates.json"
mkdir -p "$cache"

exec 9>"$cache/updates.lock"
flock 9

if [[ ${1:-} != --force && -s $out && $(cat "$cache/repo.rc" 2>/dev/null) != 1 ]] &&
  (($(date +%s) - $(stat -c %Y "$out") < 120)); then
  cat "$out"
  exit 0
fi

# Boot race: waybar starts ~2 s before Wi-Fi connects, and with a 6 h
# interval a failed first check would stick. Returns at once when online.
nm-online -q -t 60 || true

checkupdates >"$cache/repo.txt" 2>/dev/null
repo_rc=$?
paru -Qua >"$cache/aur.txt" 2>/dev/null # exits 1 when empty too: count lines
echo "$repo_rc" >"$cache/repo.rc"
repo=$(grep -c . "$cache/repo.txt")
aur=$(grep -c . "$cache/aur.txt")
total=$((repo + aur))

if ((repo_rc == 1)); then
  # Retry once in 5 min via the module's signal (20). retry.lock keeps one
  # pending retry across bars; fds closed so waybar and flock aren't held.
  (
    flock -n 8 || exit 0
    sleep 300
    pkill -RTMIN+20 -x waybar
  ) 8>"$cache/retry.lock" 9>&- </dev/null >/dev/null 2>&1 &
  disown
  json=$(jq -cn '{text: "󰮯 !", tooltip: "Couldn'\''t check the official repositories\nClick to retry", class: "error"}')
elif ((total == 0)); then
  json='{"text": "", "tooltip": "Up to date"}'
else
  json=$(jq -cn --arg t "󰮯 $total" --arg tip "Official: $repo  ·  AUR: $aur" \
    '{text: $t, tooltip: ($tip + "\nClick to upgrade"), class: "pending"}')
fi
printf '%s\n' "$json" >"$out.tmp" && mv "$out.tmp" "$out"
printf '%s\n' "$json"
