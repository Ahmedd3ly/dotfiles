#!/usr/bin/env bash
# █░█░█ ▄▀█ █░░ █░░ ▄▄ █▀█ █ █▀▀ █▄▀
# ▀▄▀▄▀ █▀█ █▄▄ █▄▄ ░░ █▀▀ █ █▄▄ █░█
#
# Why: the wallpaper menu. Themes are folders in ~/Pictures/Wallpapers; with
# more than one folder you pick the theme first, then the wallpaper. The
# choice goes to wall-set, which sets it and recolours the desktop.
# Thumbnails and rows come from wall-cache --menu; layout: rofi/wallpicker.rasi.
# Bound to SUPER+Shift+W (hypr/modules/binds.lua).
set -euo pipefail

root="${WALL_DIR:-$HOME/Pictures/Wallpapers}"
theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/wallpicker.rasi"
cur=$(readlink -f "${XDG_CACHE_HOME:-$HOME/.cache}/wall/current" 2>/dev/null || true)

# Logical width of the focused monitor (resolution / scale).
mon_w=$(hyprctl monitors 2>/dev/null | awk '
    / at / && /@/ { split($1, r, "x"); w = r[1] }
    /scale:/      { s = $2 }
    /focused: yes/ { printf "%d", w / s }' || true)
mon_w=${mon_w:-1920}

# Rows go through a temp file: they hold NUL separators (name\0icon\x1fthumb),
# and bash drops NULs from $(...) output.
rows=$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" wall-pick.XXXXXX)
trap 'rm -f "$rows"' EXIT

# $1 folder, $2 entry to preselect, $3 prompt. Prints the chosen name.
pick() {
    local n cols
    wall-cache --menu "$1" > "$rows"
    [ -s "$rows" ] || { echo "wall-pick: nothing in $1" >&2; return 1; }
    n=$(wc -l < "$rows")
    cols=$(( (mon_w - 100) / 236 ))          # 200px icon + padding + spacing
    (( cols > n )) && cols=$n
    (( cols < 1 )) && cols=1
    rofi -dmenu -i -p "$3" -theme "$theme" -select "$2" \
        -theme-str "window { width: $(( cols * 236 + 40 ))px; } listview { columns: $cols; }" < "$rows"
}

dir=$root
mapfile -t folders < <(find "$root" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
if (( ${#folders[@]} > 1 )); then
    t=$(pick "$root" "$(basename "$(dirname "$cur")")" theme) || exit 0
    dir="$root/$t"
elif (( ${#folders[@]} == 1 )); then
    dir="$root/${folders[0]}"
fi

name=$(pick "$dir" "$(basename "${cur%.*}")" wallpaper) || exit 0
img=$(find "$dir" -maxdepth 1 -type f -name "$name.*" -print -quit)
[ -n "$img" ] || { echo "wall-pick: no file for $name in $dir" >&2; exit 1; }
wall-set "$img"
