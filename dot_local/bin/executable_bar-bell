#!/usr/bin/env bash
# █▄▄ █▀▀ █░░ █░░
# █▄█ ██▄ █▄▄ █▄▄
#
# Why: the bar's notification bell. Shows do-not-disturb state, and a small
# red dot while mako holds notifications (on screen, or hidden by DND).
# mako pokes the bar on every new notification (on-notify in its config);
# waybar also re-runs this every few seconds so the dot clears after
# timeouts and dismissals.
set -uo pipefail

count() {   # makoctl list: JSON in older mako, plain text in newer
    local out
    out=$(makoctl list 2>/dev/null) || { echo 0; return; }
    if [[ "$out" == "{"* ]]; then
        jq '.data[0] | length' <<< "$out"
    else
        grep -c '^Notification' <<< "$out"
    fi
}

n=$(count)
if makoctl mode | grep -qx do-not-disturb; then bell="󰂛" state="dnd"; else bell="󰂚" state="on"; fi

if [ "${n:-0}" -gt 0 ]; then
    text="$bell<span foreground='#f38ba8' size='x-small' rise='5pt'>●</span>"
    tip="$n notification(s)  ·  right-click dismisses all"
    class="$state unread"
else
    text="$bell"
    tip="No notifications  ·  click toggles do-not-disturb"
    class="$state"
fi

jq -cn --arg t "$text" --arg tip "$tip" --arg c "$class" '{text: $t, tooltip: $tip, class: $c}'
