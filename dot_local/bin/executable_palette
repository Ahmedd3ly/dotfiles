#!/usr/bin/env python3
# █▀█ ▄▀█ █░░ █▀▀ ▀█▀ ▀█▀ █▀▀
# █▀▀ █▀█ █▄▄ ██▄ ░█░ ░█░ ██▄
#
# Why: show the colours matugen takes from the current wallpaper, drawn like
# HyDE's wallbash palette window: per palette (primary, secondary, tertiary,
# neutral) a round swatch of the role colour the desktop uses, ringed, over
# the end of a pill-shaped ramp of tones 10 -> 95. Text can't draw circles,
# so this renders a PNG with Pillow (python-pillow, as wall-cache) and shows
# it with kitty's image protocol (kitten icat): kitty only.
# Colours are read live from matugen (--dry-run -j hex: nothing is written);
# redrawn when wall-set changes the wallpaper (inotifywait on
# ~/.cache/wall/current, no polling) and when the window is resized.
# Showcase piece. Ctrl+C quits.
# Usage: palette
import json
import os
import signal
import subprocess
import sys
from pathlib import Path

from PIL import Image, ImageDraw

PALETTES = ("primary", "secondary", "tertiary", "neutral")
TONES = ("10", "20", "30", "40", "50", "60", "70", "80", "90", "95")
SS = 3  # supersampling: draw 3x, scale down for smooth round edges
WALL = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "wall"
OUT = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "palette.png"


class Resized(Exception):
    pass


def rgb(hexstr):
    return tuple(int(hexstr[i:i + 2], 16) for i in (1, 3, 5))


def colours():
    img = (WALL / "current").resolve(strict=True)
    mode = subprocess.run(["theme-get", "mode"], capture_output=True, text=True).stdout.strip() or "dark"
    out = subprocess.run(["matugen", "-q", "image", str(img), "-m", mode, "--dry-run", "-j", "hex"],
                         capture_output=True, text=True, check=True).stdout
    data = json.loads(out)
    rows = []
    for p in PALETTES:
        role = data["colors"].get(p, {}).get("default", {}).get("color") or data["palettes"][p]["80"]["color"]
        rows.append((rgb(role), [rgb(data["palettes"][p][t]["color"]) for t in TONES]))
    return rows


def render(rows, width, height):
    W, H = width * SS, height * SS
    pill_h = W * 0.075
    gap = W * 0.04
    scale = min(1.0, H * 0.84 / (4 * pill_h + 3 * gap))  # fit short windows
    pill_h, gap = pill_h * scale, gap * scale
    d = pill_h * 1.18                            # swatch a little taller than the pill
    ring = d * 0.11
    # Side margins follow the pill size (not the window width), so a wide,
    # short window gets long ramps instead of empty sides.
    margin = min(W * 0.07, pill_h * 0.8)
    top = (H - (4 * pill_h + 3 * gap)) / 2
    x0 = margin + d / 2                          # pill starts under the swatch's centre
    x1 = W - margin
    seg = (x1 - x0) / len(TONES)

    img = Image.new("RGBA", (int(W), int(H)), (0, 0, 0, 0))
    for i, (role, ramp) in enumerate(rows):
        y = top + i * (pill_h + gap)
        # Pill: the tone segments, cut to a rounded shape by a mask.
        layer = Image.new("RGBA", img.size, (0, 0, 0, 0))
        dl = ImageDraw.Draw(layer)
        for j, c in enumerate(ramp):
            dl.rectangle([x0 + j * seg, y, x0 + (j + 1) * seg + 1, y + pill_h], fill=c + (255,))
        mask = Image.new("L", img.size, 0)
        ImageDraw.Draw(mask).rounded_rectangle([x0, y, x1, y + pill_h], radius=pill_h / 2, fill=255)
        img.paste(layer, (0, 0), mask)
        # Swatch: ring, then the role colour, centred on the pill's left end.
        cy = y + pill_h / 2
        di = ImageDraw.Draw(img)
        di.ellipse([x0 - d / 2, cy - d / 2, x0 + d / 2, cy + d / 2], fill=(236, 236, 242, 255))
        r = d / 2 - ring
        di.ellipse([x0 - r, cy - r, x0 + r, cy + r], fill=role + (255,))
    img.resize((width, height), Image.LANCZOS).save(OUT)


def window_size():
    out = subprocess.run(["kitten", "icat", "--print-window-size"],
                         capture_output=True, text=True).stdout.strip()
    w, h = (int(v) for v in out.split("x"))
    return w, h


def draw():
    sys.stdout.write("\x1b[H\x1b[2J")
    sys.stdout.flush()
    subprocess.run(["kitten", "icat", "--clear"])
    try:
        rows = colours()
    except (OSError, subprocess.CalledProcessError, KeyError, ValueError):
        print("palette: no wallpaper colours yet (wall-set <image>)")
        return
    w, h = window_size()
    render(rows, w, max(h - 40, 100))  # leave a little room below
    subprocess.run(["kitten", "icat", "--align", "left", str(OUT)])


def on_resize(*_):
    raise Resized


def main():
    if os.environ.get("TERM") != "xterm-kitty" and "KITTY_WINDOW_ID" not in os.environ:
        sys.exit("palette: needs kitty (it draws with kitty's image protocol)")
    sys.stdout.write("\x1b[?25l")  # hide the cursor while showing
    signal.signal(signal.SIGWINCH, on_resize)
    watcher = None
    try:
        draw()
        while True:
            # wall-set replaces the link (ln -sfn): wait for that, then redraw.
            watcher = subprocess.Popen(["inotifywait", "-qq", "-e", "create", "-e", "moved_to",
                                        "--include", "/current$", str(WALL)])
            try:
                watcher.wait()
            except Resized:
                watcher.kill()
                watcher.wait()
            draw()
    except KeyboardInterrupt:
        pass
    finally:
        if watcher and watcher.poll() is None:
            watcher.kill()
        subprocess.run(["kitten", "icat", "--clear"])
        sys.stdout.write("\x1b[?25h\n")


if __name__ == "__main__":
    main()
