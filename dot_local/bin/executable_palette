#!/usr/bin/env bash
# █▀█ ▄▀█ █░░ █▀▀ ▀█▀ ▀█▀ █▀▀
# █▀▀ █▀█ █▄▄ ██▄ ░█░ ░█░ ██▄
#
# Why: show the colours matugen takes from the current wallpaper, like HyDE's
# wallbash palette window: one row per palette (primary, secondary, tertiary,
# neutral), tones dark -> light, led by a swatch of the role colour the
# desktop uses (mode-aware). Read live from matugen (--dry-run -j hex:
# nothing is written) and redrawn whenever wall-set changes the wallpaper
# (inotifywait on ~/.cache/wall/current: no polling, no CPU while waiting).
# Showcase piece. Ctrl+C quits.
# Usage: palette            (any terminal with truecolor: kitty)
set -euo pipefail

dir="${XDG_CACHE_HOME:-$HOME/.cache}/wall"
tones=(10 20 30 40 50 60 70 80 90 95)
bg() { printf '\e[48;2;%d;%d;%dm' "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}"; }

draw() {
    local img json cols w block role ramp p t
    img=$(readlink -e "$dir/current") \
        || { clear; echo "palette: no wallpaper set yet (wall-set <image>)"; return; }
    json=$(matugen -q image "$img" -m "$(theme-get mode)" --dry-run -j hex) || return
    cols=$(tput cols 2>/dev/null || echo 80)
    w=$(( (cols - 12) / ${#tones[@]} )); (( w < 2 )) && w=2
    block=$(printf '%*s' "$w" '')
    clear; echo
    for p in primary secondary tertiary neutral; do
        role=$(jq -r --arg p "$p" '.colors[$p].default.color // .palettes[$p]["80"].color' <<<"$json")
        ramp=""
        for t in "${tones[@]}"; do
            ramp+="$(bg "$(jq -r --arg p "$p" --arg t "$t" '.palettes[$p][$t].color' <<<"$json")")$block"
        done
        for _ in 1 2; do   # two rows high: role swatch, then the ramp
            printf '  %s    \e[0m  %s\e[0m\n' "$(bg "$role")" "$ramp"
        done
        echo
    done
}

tput civis 2>/dev/null || true                 # hide the cursor while showing
trap 'tput cnorm 2>/dev/null; exit 0' INT TERM
draw
# wall-set replaces the link (ln -sfn): wait for that, then redraw.
while inotifywait -qq -e create -e moved_to --include '/current$' "$dir"; do
    draw
done
