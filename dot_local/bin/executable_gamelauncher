#!/usr/bin/env python3
# █▀▀ ▄▀█ █▀▄▀█ █▀▀ █▀
# █▄█ █▀█ █░▀░█ ██▄ ▄█
#
# Why: SUPER+Shift+G. One catalog for every game on the machine, HyDE's
# Steam Deck picker rebuilt small: rofi grid of covers inside a handheld
# frame, sized to the focused monitor. Backends live in
# ~/.local/lib/gamelauncher (steam.py, heroic.py, manual.py; one concern
# each, standard library only, no venv). This replaces HyDE's catalog.py +
# gamelauncher.sh: rofi returns the row index (-format i), so nothing is
# parsed back out of the displayed text.
# Frame image (optional, not in the repo): ~/.local/share/gamelauncher/
# steamdeck_holographic.png, see RUNBOOK.md. Without it: a plain glass panel.
# Usage: gamelauncher            pick and launch
#        gamelauncher --list     what each backend found (debugging)

import html
import json
import shutil
import struct
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # no __pycache__ in ~/.local/lib/gamelauncher
sys.path.insert(0, str(Path.home() / ".local/lib/gamelauncher"))
import heroic, manual, steam  # noqa: E402

THEME = Path.home() / ".config/rofi/gamelauncher.rasi"
FRAME = Path.home() / ".local/share/gamelauncher/steamdeck_holographic.png"
# The frame's screen area as fractions of the image (left, top, right, bottom),
# inset a little so covers don't touch the bezel.
SCREEN = (0.215, 0.07, 0.785, 0.92)
COLUMNS, SPACING, TEXT_H = 3, 24, 56


def catalog():
    games = []
    for backend in (steam, heroic, manual):
        try:
            games += backend.games()
        except Exception as e:  # one broken backend must not hide the rest
            print(f"gamelauncher: {backend.__name__}: {e}", file=sys.stderr)
    games.sort(key=lambda g: g["name"].casefold())
    names = [g["name"].casefold() for g in games]
    for g in games:  # same title in two stores: say which is which
        label = html.escape(g["name"])
        if names.count(g["name"].casefold()) > 1:
            label += f" <span alpha='55%' size='small'>{g['backend']}</span>"
        g["label"] = label
    return games


def monitor():
    """Logical width and height of the focused monitor."""
    try:
        mons = json.loads(
            subprocess.run(
                ["hyprctl", "-j", "monitors"], capture_output=True, text=True
            ).stdout
        )
        m = next(m for m in mons if m.get("focused"))
        w, h = m["width"] / m["scale"], m["height"] / m["scale"]
        return (h, w) if m.get("transform", 0) % 2 else (w, h)
    except Exception:
        return 1920, 1080


def png_size(path):
    with open(path, "rb") as f:
        return struct.unpack(">II", f.read(24)[16:24])


def layout():
    lw, lh = monitor()
    if FRAME.is_file():
        iw, ih = png_size(FRAME)
        W = round(lw * 0.8)
        H = round(W * ih / iw)
        l, t, r, b = (
            round(v)
            for v in (
                W * SCREEN[0],
                H * SCREEN[1],
                W * (1 - SCREEN[2]),
                H * (1 - SCREEN[3]),
            )
        )
        sw, sh = W - l - r, H - t - b
        icon = int(min(sh - TEXT_H, (sw - (COLUMNS - 1) * SPACING) / COLUMNS * 1.5))
        return (
            f"window {{ width: {W}px; height: {H}px; "
            f'background-image: url("{FRAME}", width); background-color: transparent; '
            f"border: 0px; border-radius: 0px; }} "
            f"mainbox {{ padding: {t}px {r}px {b}px {l}px; }} "
            f"element-icon {{ size: {icon}px; }}"
        )
    W = round(lw * 0.6)
    icon = int(min(lh * 0.42, (W - 80 - (COLUMNS - 1) * SPACING) / COLUMNS * 1.5))
    return f"window {{ width: {W}px; }} element-icon {{ size: {icon}px; }}"


def launch(g):
    wrap = ["uwsm", "app", "--"] if shutil.which("uwsm") else []
    if "url" in g:
        cmd, cwd = wrap + ["gio", "open", g["url"]], None
    elif "argv" in g:
        cmd, cwd = wrap + g["argv"], g.get("cwd")
    else:
        cmd, cwd = wrap + ["sh", "-c", g["shell"]], g.get("cwd")
    subprocess.Popen(
        cmd,
        cwd=cwd,
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    games = catalog()
    if "--list" in sys.argv:
        for g in games:
            how = g.get("url") or g.get("shell") or " ".join(g.get("argv", []))
            print(
                f"{g['backend']:7} {g['name']:40.40} {how}   icon={'yes' if g['icon'] else 'no'}"
            )
        return 0
    if not games:
        subprocess.run(
            [
                "notify-send",
                "-a",
                "gamelauncher",
                "No games found",
                "Steam, Heroic and /games were empty",
            ]
        )
        return 1
    rows = "\n".join(
        g["label"] + (f"\0icon\x1f{g['icon']}" if g["icon"] else "") for g in games
    )
    pick = subprocess.run(
        [
            "rofi",
            "-dmenu",
            "-i",
            "-markup-rows",
            "-format",
            "i",
            "-p",
            "Games",
            "-theme",
            str(THEME),
            "-theme-str",
            layout(),
        ],
        input=rows,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if pick.isdigit():
        launch(games[int(pick)])
    return 0


if __name__ == "__main__":
    sys.exit(main())
