// █▀▄▀█ █▀▀ █▄░█ █░█
// █░▀░█ ██▄ █░▀█ █▄█
//
// Why: the layout for long-row dmenu menus (keyhint, anim-pick), which pass
// it with -theme. Short-row menus use the default, clipboard.rasi.
// Ported from HyDE (GPL-3.0): https://github.com/HyDE-Project/HyDE/tree/master/Configs/.local/share/hyde/rofi/themes/clipboard.rasi
// Changes: wallpaper crops from ~/.cache/wall (wall-cache), look from
// theme.rasi, the full-width wallpaper banner from style_10 instead of
// the blur strip + thumbnail, and 33em wide so keyhint's longest row
// (~66 chars) fits; anything longer is cut with … on purpose.
/**
 * ROFI Layout 
 *
 * Base style for clipboard style Layout.
 * 
 * User: The HyDE Project [ mini dropdown menu ]
 * Copyright: The HyDE Project
 */

// Config //
configuration {
    modi:                        "drun";
    show-icons:                  false;
}

@theme "~/.config/rofi/theme.rasi"


// Main //
window {
    width:                       28em;
    height:                      33em;
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border-color:                @main-br;
    background-color:            @main-bg;
}
mainbox {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0.5em;
    orientation:                 vertical;
    children:                    [ "inputbar" , "listbox" ];
    background-color:            transparent;
}


// Inputs //
// Banner from style_10: the wallpaper crop across the full width, search
// pill floating on it (style_10 hides the entry; a dmenu needs it).
inputbar {
    enabled:                     true;
    padding:                     2.5em 4em;
    children:                    [ "entry" ];
    background-color:            transparent;
    background-image:            url("~/.cache/wall/thmb.png", width);
    border-radius:               1em;
    expand:                      false;
}
entry {
    enabled:                     true;
    padding:                     0.6em 1em;
    border-radius:               1em;
    text-color:                  @main-fg;
    background-color:            @main-bg;
    placeholder:                 "search";
    placeholder-color:           #cdd6f480;
}


// Lists //
listbox {
    spacing:                     0em;
    padding:                     0em;
    orientation:                 vertical;
    children:                    [ "dummy" , "listview" , "dummy" ];
    background-color:            transparent;
}
listview {
    enabled:                     true;
    padding:                     0.5em;
    columns:                     1;
    lines:                       11; 
    cycle:                       true;
    fixed-height:                true;
    fixed-columns:               false;
    expand:                      false;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @main-fg;
}
dummy {
    spacing:                     0em;
    padding:                     0em;
    background-color:            transparent;
}


// Elements //
element {
    enabled:                     true;
    padding:                     0.5em;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @main-fg;
}
element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}
element-text {
    vertical-align:              0.0;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

