// █▀█ █▀█ █░█░█ █▀▀ █▀█
// █▀▀ █▄█ ▀▄▀▄▀ ██▄ █▀▄
//
// Why: wlogout's look (a row of big tiles) without wlogout: one row of five
// tiles, Nerd Font glyph over the label. Rows come from powermenu as Pango
// markup with a newline in each, hence -sep '|' and -eh 4 there.
// Colours, border and rounding come from theme.rasi; the accent fill of the
// selected tile follows the wallpaper (accents.rasi).

configuration {
    show-icons:                  false;
}

@theme "~/.config/rofi/theme.rasi"

window {
    width:                       860px;
    padding:                     20px;
    transparency:                "real";
    background-color:            @main-bg;
    border-color:                @main-br;
}
mainbox {
    children:                    [ "listview" ];
    background-color:            transparent;
}
listview {
    columns:                     5;
    lines:                       1;
    spacing:                     16px;
    fixed-columns:               true;
    fixed-height:                true;
    dynamic:                     false;
    scrollbar:                   false;
    cursor:                      "default";
    background-color:            transparent;
}
element {
    padding:                     16px 0px;
    cursor:                      pointer;
    background-color:            #31324466;   /* surface0, faint tile */
    text-color:                  @main-fg;
}
element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}
element-text {
    font:                        "JetBrainsMono Nerd Font 13";
    horizontal-align:            0.5;
    vertical-align:              0.5;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}
