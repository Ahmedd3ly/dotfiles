// █▀█ █▀█ █▀▀ █
// █▀▄ █▄█ █▀░ █
//
// Why: the global look every rofi layout imports (styles/*.rasi, clipboard.rasi, menu.rasi):
// colours from HyDE's "Catppuccin Mocha" rofi.theme, plus the window border
// and rounding HyDE injected at launch (border = Hyprland border_size,
// window radius = rounding x 3, row radius = rounding x 2). A layout that
// sets its own radius still wins, because it is read after this file.
// COLOURS: both from matugen. palette.rasi = the current theme's neutrals
// (main-bg, main-fg, placeholder-fg, tile-bg; theme-pick, SUPER+Shift+T);
// accents.rasi = main-br, select-bg, select-fg from the wallpaper, imported
// at the end so it overrides.

@import "~/.config/rofi/palette.rasi"

* {
    separatorcolor:     transparent;
    border-color:       transparent;
}

window {
    border:             2px;
    border-radius:      30px;
}

element {
    border-radius:      20px;
}

@import "~/.config/rofi/accents.rasi"
