# █▀▀ ▄▀█ █░█ ▄▀█
# █▄▄ █▀█ ▀▄▀ █▀█
#
# Why: cava (terminal audio visualiser) in the wallpaper's colours. Colours
# live in themes/matugen, generated by matugen on every wall-set; wall-set
# then sends SIGUSR2 so a running cava reloads them. Everything not set here
# is cava's default (all keys: /usr/share/doc/cava/README.md). Keys r / c in
# cava reload the config / colours by hand.

[output]
# noncurses: the only terminal output that supports horizontal gradients
# (themes/matugen colours left to right).
method = noncurses

[color]
# themes are read from ~/.config/cava/themes
theme = 'matugen'
