# Odoo dev (details: ~/Projects/odoo/README.md)
#
#   $ODOO_ROOT/versions/<x.0>/{odoo,enterprise}   shared upstream code, never edited
#   $ODOO_ROOT/clients/<client>/                  one workspace per client:
#       .odoo-version  odoo.conf  .venv/  src/  .pylintrc -> $ODOO_CFG/client.pylintrc.template
#       .venv/.../site-packages/odoo-src.pth   puts versions/<x.0>/odoo on the venv's path (pylint)
#   $ODOO_ROOT/odools.toml                        generated by odoo-lsconf, one profile per client
#
#   odoo <client> [odoo-bin args]              run odoo-bin with the client's venv, config and version
#   onv <client>                               cd into the workspace + nvim (selects its odoo-ls profile)
#   odoo-new <client> <ver> <branch> <repo>    create a workspace end to end
#   odoo-lsconf                                regenerate odools.toml from every client's odoo.conf

typeset -g ODOO_ROOT=~/Projects/odoo
typeset -g ODOO_CFG=${XDG_CONFIG_HOME:-$HOME/.config}/odoo
typeset -g ODOO_PY=3.12   # Python for new venvs (19.0, 20.0); override: ODOO_PY=3.10 odoo-new ...

# ---------- helpers ----------------------------------------------------------

# _odoo_err <msg>: print "<calling function>: <msg>" to stderr, return 1
_odoo_err() { print -u2 -- "${funcstack[2]}: $*"; return 1; }

# _odoo_ws <client>: print the workspace path; fail unless it exists and has .odoo-version
_odoo_ws() {
  local c=$ODOO_ROOT/clients/$1
  [[ -n $1 && -d $c ]] || { print -u2 -- "no client '$1' in $ODOO_ROOT/clients"; return 1; }
  [[ -r $c/.odoo-version ]] || { print -u2 -- "no .odoo-version in $c"; return 1; }
  print -r -- $c
}

# ---------- daily use --------------------------------------------------------

odoo() {
  (( $# )) || { _odoo_err "usage: odoo <client> [odoo-bin args]"; return; }
  local c v
  c=$(_odoo_ws $1) || return; shift
  v=$(<$c/.odoo-version)
  systemctl is-active -q postgresql || { _odoo_err "postgresql stopped (sudo systemctl start postgresql)"; return; }
  $c/.venv/bin/python $ODOO_ROOT/versions/$v/odoo/odoo-bin -c $c/odoo.conf "$@"
}

onv() {
  (( $# )) || { _odoo_err "usage: onv <client>"; return; }
  local c
  c=$(_odoo_ws $1) || return
  cd $c && nvim
}

# ---------- workspace setup --------------------------------------------------

odoo-new() {
  (( $# == 4 )) || { _odoo_err "usage: odoo-new <client> <version> <branch> <git-repo>"; return; }
  local client=$1 version=$2 branch=$3 repo=$4 c=$ODOO_ROOT/clients/$1
  # The name is also the database prefix that dbfilter matches.
  [[ $client =~ '^[a-z0-9_-]+$' ]] || { _odoo_err "client name: lowercase letters, digits, _ and - only"; return; }
  [[ -d $ODOO_ROOT/versions/$version/odoo ]] || { _odoo_err "no $ODOO_ROOT/versions/$version/odoo"; return; }
  [[ -e $c ]] && { _odoo_err "$c already exists"; return; }

  mkdir -p $c/src && cd $c || return
  local py=$c/.venv/bin/python   # explicit target: an activated venv must not catch the installs
  if print -r -- $version > .odoo-version &&
     git clone --recurse-submodules -b $branch $repo src/ &&
     uv venv --python $ODOO_PY .venv &&
     print -r -- $ODOO_ROOT/versions/$version/odoo > \
       "$($py -c 'import sysconfig; print(sysconfig.get_path("purelib"))')/odoo-src.pth" &&  # pylint can import odoo
     uv pip install --python $py -r $ODOO_ROOT/versions/$version/odoo/requirements.txt &&
     { [[ ! -f src/requirements.txt ]] || uv pip install --python $py -r src/requirements.txt; } &&
     uv pip install --python $py pylint pylint-odoo &&          # editor linting (nvim-lint)
     { [[ -e src/.pylintrc ]] || ln -s $ODOO_CFG/client.pylintrc.template .pylintrc; } &&  # repo's own wins
     sed -e "s/<client>/$client/g" -e "s/<version>/$version/g" -e "s/<vNN>/v${version%.0}/g" \
         $ODOO_CFG/client.conf.template > odoo.conf
  then
    odoo-lsconf && odoo $client --version                       # expect: Odoo Server <version>
  else
    _odoo_err "setup failed; fix the cause, then: cd ~ && rm -rf $c && odoo-new $*"
  fi
}

# Settings every generated profile shares:
#   tsserver_command = ""              no TypeScript server, so no OWL/JS features; to enable them,
#                                      `pacman -S typescript` and set this to "tsserver"
#   diag_missing_imports = "only_odoo" report missing imports for Odoo modules only
typeset -ga ODOO_LS_SHARED=('tsserver_command = ""' 'diag_missing_imports = "only_odoo"')

odoo-lsconf() {
  local out=$ODOO_ROOT/odools.toml c v ap p n=0
  local -a paths
  {
    print '# ┌────────────────────────────────────────────────────────┐'
    print '# │  DO NOT EDIT: generated by `odoo-lsconf` (45-odoo.zsh) │'
    print '# │  Source: clients/*/odoo.conf, .odoo-version, .venv     │'
    print '# └────────────────────────────────────────────────────────┘'
    for c in $ODOO_ROOT/clients/*(/N); do
      [[ -r $c/.odoo-version && -r $c/odoo.conf ]] || continue
      v=$(<$c/.odoo-version)
      ap=$(sed -n 's/^[[:space:]]*addons_path[[:space:]]*=[[:space:]]*//p' $c/odoo.conf)
      paths=()
      for p in ${(s:,:)ap}; do
        p=${p//[[:space:]]/}; p=${p/#\~/$HOME}
        [[ -n $p ]] && paths+=("\"$p\"")
      done
      print "\n[[config]]"
      print "name = \"${c:t}\""
      print "odoo_path = \"$ODOO_ROOT/versions/$v/odoo\""
      print "addons_paths = [${(j:, :)paths}]"
      print "python_path = \"$c/.venv/bin/python\""
      print -l -- $ODOO_LS_SHARED
      (( n++ ))
    done
  } >| $out
  print -- "odoo-lsconf: $n profile(s) -> $out"
}
