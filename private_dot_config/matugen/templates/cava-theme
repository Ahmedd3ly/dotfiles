#
# Generated by matugen from ~/.config/matugen/templates/cava-theme
# on every wall-set; edits here are overwritten. Change the template instead.
# Why: bars in the wallpaper's two accents, left to right: primary ->
# tertiary (matugen's distinct companion hue; "secondary" is only a muted
# primary), saturated +40 so it stands apart (most hit full saturation
# there; same lightness, so no brighter). Horizontal, because bars rarely
# reach the top of the window, so a bottom-to-top gradient only ever showed
# its first colour. Needs method = noncurses (cava/config). Mode-aware
# tones. No background: kitty's translucent one shows through.
[color]
horizontal_gradient = 1
horizontal_gradient_color_1 = '{{ colors.primary.default.hex }}'
horizontal_gradient_color_2 = '{{ colors.tertiary.default.hex | saturate: 40.0, "hsl" }}'
