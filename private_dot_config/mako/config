# █▀▄▀█ ▄▀█ █▄▀ █▀█
# █░▀░█ █▀█ █░█ █▄█
#
# Why: notifications in the same language as the bar islands: Mocha base
# at 90% (the "notifications" layer rule blurs behind it), 10 px rounding
# like the windows, accent border. Do-not-disturb is the bell in the bar.
# Reload after edits: makoctl reload
# ACCENTS: the default border colour comes from ./accents (matugen primary,
# included below); urgency border colours stay fixed.

font=JetBrainsMono Nerd Font 10
background-color=#1e1e2ee6
text-color=#cdd6f4

# Wallpaper accent (border-color). Seeded by chezmoi, regenerated by matugen.
include=~/.config/mako/accents

border-size=2
border-radius=10
padding=12,14
margin=10
outer-margin=6
width=360
height=160
icon-location=left
max-icon-size=48

anchor=top-right
layer=overlay
default-timeout=5000
max-visible=5
group-by=app-name

format=<b>%s</b>\n%b

# Light the red dot on the bar's bell right away (bar-bell, signal 11).
on-notify=exec pkill -RTMIN+11 waybar

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=critical]
border-color=#f38ba8
default-timeout=0

# On-screen indicator (~/.local/bin/osd): volume, brightness, mic. One popup,
# replaced in place, bottom centre, icon only; the accent fill is the level
# (progress-color, from ./accents). Kept out of history and doesn't light
# the bell.
[app-name=osd]
anchor=bottom-center
width=220
margin=0,0,56,0
padding=6,0
font=JetBrainsMono Nerd Font 18
text-alignment=center
format=%s
icons=0
default-timeout=1200
history=0
on-notify=none

# Bell in the bar: makoctl mode -t do-not-disturb. Hides everything except
# critical notifications (low battery, etc.).
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0

# Volume and brightness feedback stays visible in do-not-disturb.
[mode=do-not-disturb app-name=osd]
invisible=0
