# █▀▄▀█ ▄▀█ █▄▀ █▀█
# █░▀░█ █▀█ █░█ █▄█
#
# Why: notifications in the bar islands' shape but the current theme's
# colours: theme base at 90% (the "notifications" layer rule blurs behind
# it), 10 px rounding like the windows, accent border. Do-not-disturb is the
# bell in the bar.
# Reload after edits: makoctl reload
# ACCENTS: the default border colour comes from ./accents (matugen primary,
# included below); urgency border colours stay fixed.

font=JetBrainsMono Nerd Font 10
# Theme neutrals (background, text): ./palette, generated by matugen from
# the current theme (theme-pick, SUPER+Shift+T). Seeded by chezmoi.
include=~/.config/mako/palette

# Wallpaper accent (border-color). Seeded by chezmoi, regenerated by matugen.
include=~/.config/mako/accents

border-size=2
border-radius=10
padding=12,14
margin=10
outer-margin=6
width=360
height=160
icon-location=left
max-icon-size=48

anchor=top-right
layer=overlay
default-timeout=5000
max-visible=5
group-by=app-name

format=<b>%s</b>\n%b

# Light the red dot on the bar's bell right away (bar-bell, signal 11).
on-notify=exec pkill -RTMIN+11 waybar

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=critical]
border-color=#f38ba8
default-timeout=0

# On-screen indicator (~/.local/bin/osd): volume, brightness, mic, drawn as a
# Windows-style slider (icon, bar, number; the bar is markup in the body).
# One popup, replaced in place, bottom centre. outer-margin (not margin) sets
# the distance from the screen edge; margin only spaces notifications apart.
# Kept out of history and doesn't light the bell.
[app-name=osd]
anchor=bottom-center
outer-margin=0,0,110,0
width=280
padding=16,10
border-size=1
border-color=#585b70
font=JetBrainsMono Nerd Font 11
text-alignment=center
format=%b
markup=1
icons=0
default-timeout=1200
history=0
on-notify=none

# Bell in the bar: makoctl mode -t do-not-disturb. Hides everything except
# critical notifications (low battery, etc.).
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0

# Volume and brightness feedback stays visible in do-not-disturb.
[mode=do-not-disturb app-name=osd]
invisible=0
