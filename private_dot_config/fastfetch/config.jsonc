// █▀▀ ▄▀█ █▀ ▀█▀ █▀▀ █▀▀ ▀█▀ █▀▀ █░█
// █▀░ █▀█ ▄█ ░█░ █▀░ ██▄ ░█░ █▄▄ █▀█
//
// Why: HyDE's two-box layout, trimmed, without its fastfetch.sh logo picker.
// The logo is wall-cache's quad crop of the current wallpaper, so it follows
// the wallpaper with no extra script. Outside kitty (a tty) the image can't
// render and fastfetch falls back to the built-in Arch logo.
// Key colours are terminal colour names, so they come from kitty's Mocha
// palette; nothing here needs a matugen template.
// GPU uses PCI detection: reads sysfs only, so it never wakes the RTX 4070.
// Run: ff (alias in zsh/conf.d/30-aliases.zsh). Check: fastfetch --show-errors
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "$HOME/.cache/wall/quad.png",
    "height": 18,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    "break",
    { "type": "title", "key": "  ", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "┌──────────────────────────────────────────┐" },
    { "type": "os",        "key": "  󰣇 OS",       "keyColor": "red",     "format": "{pretty-name}" },
    { "type": "kernel",    "key": "   Kernel",   "keyColor": "red",     "format": "{release}" },
    { "type": "packages",  "key": "  󰏗 Packages", "keyColor": "green" },
    { "type": "wm",        "key": "  󱗃 WM",       "keyColor": "yellow",  "format": "{pretty-name} {version}" },
    { "type": "terminal",  "key": "   Terminal", "keyColor": "yellow" },
    { "type": "shell",     "key": "   Shell",    "keyColor": "yellow",  "format": "{pretty-name} {version}" },
    { "type": "display",   "key": "  󰍹 Display",  "keyColor": "green",   "format": "{width}x{height} @ {refresh-rate}Hz [{type}]" },
    { "type": "custom", "format": "└──────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "format": "┌──────────────────────────────────────────┐" },
    { "type": "cpu",       "key": "   CPU",      "keyColor": "blue",    "format": "{name}" },
    { "type": "gpu",       "key": "  󰊴 GPU",      "keyColor": "blue",    "format": "{name}", "detectionMethod": "pci" },
    { "type": "memory",    "key": "  󰍛 Memory",   "keyColor": "magenta" },
    { "type": "battery",   "key": "  󰁹 Battery",  "keyColor": "magenta" },
    { "type": "disk",      "key": "  󱦟 OS Age",   "keyColor": "cyan",    "folders": "/", "format": "{days} days" },
    { "type": "uptime",    "key": "  󱫐 Uptime",   "keyColor": "cyan" },
    { "type": "custom", "format": "└──────────────────────────────────────────┘" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
