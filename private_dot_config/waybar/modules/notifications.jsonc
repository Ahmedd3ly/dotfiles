// Notification bell (replaces HyDE's custom/swaync): do-not-disturb toggle,
// red dot while mako holds notifications (bar-bell).
// The "do-not-disturb" mode is defined in ~/.config/mako/config.
{
  "custom/notifications": {
    "exec": "$HOME/.local/bin/bar-bell",
    "return-type": "json",
    "interval": 3,
    "signal": 11,
    "on-click": "makoctl mode -t do-not-disturb; pkill -RTMIN+11 waybar",
    "on-click-right": "makoctl dismiss -a; pkill -RTMIN+11 waybar"
  }
}
