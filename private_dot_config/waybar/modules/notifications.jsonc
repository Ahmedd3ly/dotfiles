// Do-not-disturb toggle for mako (replaces HyDE's custom/swaync).
// The "do-not-disturb" mode is defined in ~/.config/mako/config.
{
  "custom/notifications": {
    "exec": "makoctl mode | grep -qx do-not-disturb && echo '󰂛' || echo '󰂚'",
    "interval": "once",
    "signal": 11,
    "tooltip-format": "Notifications: click toggles do-not-disturb, right-click dismisses all",
    "on-click": "makoctl mode -t do-not-disturb && pkill -RTMIN+11 waybar",
    "on-click-right": "makoctl dismiss -a"
  }
}
