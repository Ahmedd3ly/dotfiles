// Privacy, updates, network, power profile, battery.
{
  "privacy": {
    "icon-spacing": 5,
    "transition-duration": 250,
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in", "tooltip": true }
    ]
  },
  // bar-updates checks every 6 h, once for all monitors (shared cache). Click
  // opens the sysupdate panel (summary, package list, snapshot + upgrade),
  // which refreshes this count when it closes.
  "custom/updates": {
    "exec": "$HOME/.local/bin/bar-updates",
    "return-type": "json",
    "interval": 21600,
    "signal": 20,
    "on-click": "kitty --class sysupdate -e $HOME/.local/bin/sysupdate"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀 {ifname} (no IP)",
    "format-disconnected": "󰖪",
    "format-alt": " {bandwidthDownBytes}  {bandwidthUpBytes}",
    "tooltip-format": "{essid}  ·  {signalStrength}%\n{ifname}  ·  {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5
  },
  // TLP profiles through tlp-pd, which speaks power-profiles-daemon's D-Bus
  // API, so waybar's built-in module drives TLP (performance / balanced /
  // power-saver). Takes the slot of the HyDE-era custom/tlp.
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}  ·  click to cycle",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": "",
      "default": ""
    }
  },
  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
