// Clock with a month calendar tooltip (scroll the tooltip to change month).
{
  "group/clock-cal": {
    "orientation": "inherit",
    "modules": ["clock"]
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%H:%M  󰃭 %a %d %b}",
    "interval": 30,
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f5c2e7'><b>{}</b></span>",
        "weekdays": "<span color='#a6adc8'><b>{}</b></span>",
        "today": "<span color='#cba6f7'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
