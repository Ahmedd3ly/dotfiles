// Clock island: a hollow-icon 12-hour time. Hovering it slides out the date;
// left-click the date for a calendar window (yad: week numbers, month/year
// navigation) that closes when focus moves elsewhere. No tooltips.
{
  "group/clock-cal": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "clock-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": ["clock", "clock#date"]
  },
  "clock": {
    "format": "󰅐  {:%I:%M %p}",
    "interval": 30,
    "tooltip": false
  },
  "clock#date": {
    "format": "󰃭  {:%a %d %b}",
    "interval": 60,
    "tooltip": false,
    "on-click": "$HOME/.local/bin/bar-calendar"
  }
}
