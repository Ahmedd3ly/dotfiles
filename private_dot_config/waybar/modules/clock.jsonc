// 12-hour clock. Hover: month calendar. Right-click: whole year (again: back).
// Scroll over the clock to page months; click toggles the date.
{
  "group/clock-cal": {
    "orientation": "inherit",
    "modules": ["clock"]
  },
  "clock": {
    "format": "󰥔  {:%I:%M %p}",
    "format-alt": "󰥔  {:%I:%M %p  󰃭 %a %d %b}",
    "interval": 30,
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#f5c2e7'><b>{}</b></span>",
        "weekdays": "<span color='#a6adc8'><b>{}</b></span>",
        "today": "<span color='#cba6f7'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
