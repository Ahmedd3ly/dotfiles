// 12-hour clock in a hover drawer that slides out the date. Hovering the
// time shows the month calendar; right-click it for the whole year (again:
// back); scroll over it to page months.
{
  "group/clock-cal": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "clock-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": ["clock", "clock#date"]
  },
  "clock#date": {
    "format": "󰃭 {:%a %d %b}",
    "interval": 60,
    "tooltip": false
  },
  "clock": {
    "format": "󰥔  {:%I:%M %p}",
    "interval": 30,
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#f5c2e7'><b>{}</b></span>",
        "weekdays": "<span color='#a6adc8'><b>{}</b></span>",
        "today": "<span color='#cba6f7'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
