// Volume with a hover drawer for the microphone. wpctl only (no pamixer).
{
  "group/volumecontrol": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "volumecontrol-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": ["pulseaudio#output", "pulseaudio#input"]
  },
  "pulseaudio#output": {
    "format": "{icon}  {volume}",
    "format-muted": "󰖁  {volume}",
    "format-icons": { "headphone": "", "headset": "", "default": ["", "", ""] },
    "tooltip-format": "{desc}  ·  {volume}%",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol -t 3"
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": "󰍬 {volume}",
    "format-source-muted": "",
    "tooltip-format": "{source_desc}  ·  {source_volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol -t 4",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  }
}
