// Hyprland state: workspaces, focused window title, keyboard layout.
{
  "hyprland/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "tooltip": false,
    // Dots, not numbers: a big dot for the active workspace, small for the rest.
    "format": "{icon}",
    "format-icons": { "active": "󰝥", "default": "󰧟" },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true,
    "max-length": 50,
    "rewrite": {
      "(.*) \u2014 Mozilla Firefox": "$1 \udb80\ude39",
      "(.*)Mozilla Firefox": "$1Firefox \udb80\ude39",
      "(.*) - nvim": "$1 \ue62b",
      "(.*)Steam": "$1Steam \udb81\udcd3",
      "(.*) - Discord": "$1 \uf1ff"
    }
  },
  // min-length 3 ("ara"): waybar lets GTK ellipsize labels when the bar runs
  // out of room, and on the narrow laptop bar (1536 px logical) this one
  // shrank to "…". A minimum width makes a longer label give way instead.
  "hyprland/language": {
    "format": "{short}",
    "min-length": 3,
    "tooltip-format": "{long}  ·  click to switch",
    "on-click": "hyprctl switchxkblayout all next"
  }
}
