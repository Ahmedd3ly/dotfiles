// Launcher button (replaces HyDE's custom/hyde-menu).
{
  "custom/menu": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Apps (left)  ·  Power (right)",
    "on-click": "$HOME/.local/bin/rofi-launch launcher",
    "on-click-right": "pkill -x rofi || $HOME/.local/bin/powermenu"
  }
}
