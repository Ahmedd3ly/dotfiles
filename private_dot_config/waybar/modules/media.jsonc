// Media: one custom module fed by bar-media (playerctl), "title - artist"
// while playing or paused, "nothing playing" otherwise, so the island is
// never empty. Hover slides out previous / play-pause / next. Replaces
// waybar's mpris module, which stayed blank here while playerctl saw the
// player.
{
  "group/mediaplayer": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "mediaplayer-drawer",
      "transition-left-to-right": true,
      "click-to-reveal": false
    },
    "modules": ["custom/media", "custom/media-prev", "custom/media-play", "custom/media-next"]
  },
  "custom/media": {
    "exec": "$HOME/.local/bin/bar-media",
    "return-type": "json",
    "restart-interval": 5,
    "escape": true,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl position 5+",
    "on-scroll-down": "playerctl position 5-"
  },
  "custom/media-prev": { "format": "󰙣", "tooltip-format": "previous", "on-click": "playerctl previous" },
  "custom/media-play": { "format": "󰐌", "tooltip-format": "play/pause", "on-click": "playerctl play-pause" },
  "custom/media-next": { "format": "󰙡", "tooltip-format": "next", "on-click": "playerctl next" }
}
