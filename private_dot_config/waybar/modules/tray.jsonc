// System tray hidden behind an arrow; hover to reveal.
{
  "group/hide-tray": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "hide-tray-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": ["custom/tray-arrow", "tray"]
  },
  "custom/tray-arrow": {
    "format": "",
    "tooltip-format": "Reveal tray"
  },
  "tray": { "spacing": 5 }
}
