// █░█░█ ▄▀█ █▄█ █▄▄ ▄▀█ █▀█
// ▀▄▀▄▀ █▀█ ░█░ █▄█ █▀█ █▀▄
//
// Why: the MyBar layout from HyDE days, same groups and order, with every
// HyDE-backed module swapped for a built-in module or a small script in
// ~/.local/bin. Module definitions live in ./modules (one concern per file),
// shapes and colours in style.css / theme.css.
// Config changes: systemctl --user restart waybar (CSS reloads by itself).
{
  "layer": "top",
  "output": ["*"],
  "height": 10,
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "reload_style_on_change": true,

  "include": [
    "$HOME/.config/waybar/modules/menu.jsonc",
    "$HOME/.config/waybar/modules/hyprland.jsonc",
    "$HOME/.config/waybar/modules/system.jsonc",
    "$HOME/.config/waybar/modules/media.jsonc",
    "$HOME/.config/waybar/modules/clock.jsonc",
    "$HOME/.config/waybar/modules/notifications.jsonc",
    "$HOME/.config/waybar/modules/weather.jsonc",
    "$HOME/.config/waybar/modules/audio.jsonc",
    "$HOME/.config/waybar/modules/status.jsonc",
    "$HOME/.config/waybar/modules/tray.jsonc",
    "$HOME/.config/waybar/modules/toggles.jsonc"
  ],

  // Group shapes (see style.css): pill = full pill, pill-in = half pill
  // curving inwards, leaf / leaf-inverse = opposite rounded corners.
  // "name#tag" reuses a shape; CSS targets the part before "#".
  "group/pill#left1": {
    "orientation": "inherit",
    "modules": ["custom/menu", "hyprland/workspaces", "hyprland/window"]
  },
  "group/pill#left2": {
    "orientation": "inherit",
    "modules": ["custom/weather"]
  },
  "group/leaf": {
    "orientation": "inherit",
    "modules": ["cpu", "memory"]
  },
  "group/pill-in": {
    "orientation": "inherit",
    "modules": ["group/mediaplayer"]
  },
  "group/leaf-inverse": {
    "orientation": "inherit",
    "modules": ["temperature#gpu", "temperature#cpu"]
  },
  "group/pill#right1": {
    "orientation": "inherit",
    "modules": [
      "group/hide-tray",
      "hyprland/language",
      "custom/keybindhint",
      "custom/gamemode",
      "custom/nightlight",
      "idle_inhibitor"
    ]
  },
  "group/pill#right2": {
    "orientation": "inherit",
    "modules": [
      "privacy",
      "group/volumecontrol",
      "custom/updates",
      "network",
      "power-profiles-daemon",
      "battery"
    ]
  },
  "group/pill#right3": {
    "orientation": "inherit",
    "modules": ["group/clock-cal", "custom/notifications"]
  },

  "modules-left": ["group/pill#left1", "group/pill#left2"],
  "modules-center": ["group/leaf", "group/pill-in", "group/leaf-inverse"],
  "modules-right": ["group/pill#right1", "group/pill#right2", "group/pill#right3"]
}
